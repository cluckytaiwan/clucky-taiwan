# Clucky Taiwan Environment Variables
# Copy this file to .env and fill in your actual values

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key-here

# Midtrans Payment Gateway
# Client key (Sandbox: Mid-client-xxx | Production: Mid-client-xxx)
VITE_MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxxx

# Set ke "true" saat deploy ke production — ini mengontrol URL Snap.js
# false = https://app.sandbox.midtrans.com/snap/snap.js (untuk testing)
# true  = https://app.midtrans.com/snap/snap.js (untuk production)
VITE_MIDTRANS_IS_PRODUCTION=false

# CORS: Set domain frontend Anda di Supabase Edge Function environment
# Contoh: ALLOWED_ORIGIN=https://clucky-taiwan.netlify.app
# (Set via Supabase dashboard → Project Settings → Edge Functions → Environment Variables)

# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual credentials in .env
# 3. Never commit .env to git (already in .gitignore)
# 4. Saat deploy production: set VITE_MIDTRANS_IS_PRODUCTION=true
